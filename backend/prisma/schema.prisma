generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  HACKER
  ADMIN
}

// Nhóm Undisclosed: NONE, PENDING, TRIAGED
// Nhóm Disclosed: RESOLVED, DUPLICATE, INFORMATIVE, NOT_APPLICABLE, SPAM
enum ReportState {
  NONE
  PENDING
  TRIAGED
  RESOLVED
  DUPLICATE
  INFORMATIVE
  NOT_APPLICABLE
  SPAM
}

enum Severity {
  NONE
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EventType {
  SUBMITTED
  COMMENT
  STATE_CHANGE
  BOUNTY
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         Role     @default(HACKER)
  // Ảnh đại diện: data URL base64 (client resize về 256px trước khi gửi) — nullable.
  avatar       String?  @db.Text
  // Mô tả ngắn trên profile (profile editor), tối đa 160 ký tự.
  bio          String?  @db.VarChar(160)
  // Denormalized: tổng điểm reputation cả đời, cập nhật cùng transaction khi ghi ReputationLedger.
  // Ledger vẫn là nguồn sự thật; cột này để leaderboard/profile khỏi phải aggregate.
  reputation   Int      @default(0)
  createdAt    DateTime @default(now())

  reports       Report[]
  events        ReportEvent[]
  ledgerEntries ReputationLedger[]

  @@index([reputation])
}

model Report {
  id               String      @id @default(uuid())
  reporterId       String
  reporter         User        @relation(fields: [reporterId], references: [id])
  target           String
  weakness         String
  cveId            String?
  shortDescription String
  details          String
  severity         Severity    @default(NONE)
  state            ReportState @default(NONE)
  bounty           Int?
  createdAt        DateTime    @default(now())
  disclosedAt      DateTime?

  events ReportEvent[]

  @@index([state])
  @@index([weakness])
  @@index([createdAt])
}

model ReportEvent {
  id           String       @id @default(uuid())
  reportId     String
  report       Report       @relation(fields: [reportId], references: [id])
  actorId      String
  actor        User         @relation(fields: [actorId], references: [id])
  type         EventType
  content      String?
  fromState    ReportState?
  toState      ReportState?
  bountyAmount Int?
  createdAt    DateTime     @default(now())

  @@index([reportId])
}

// So sổ điểm — mỗi dòng là một lần cộng/trừ, có timestamp riêng.
// Reputation = tổng tất cả dòng. Signal = tổng các dòng trong 365 ngày gần nhất.
// TV4 (Backend Security) sẽ dùng bảng này để tính Reputation/Signal và rate limit.
model ReputationLedger {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  points    Int
  reason    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
